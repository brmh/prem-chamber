---
import { localePath } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base
  lang="en"
  path="/404"
  title="Page not found | Prem Chamber"
  description="The page you were looking for is not here."
  noindex={true}
  langPath="/"
>
  <div class="section">
    <div class="wrap-narrow" style="text-align:center">
      <h1>Page not found</h1>
      <p class="lede">यह पेज यहाँ नहीं है. The page you were looking for has moved or never existed.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href={localePath('en', '/')}>Home</a>
        <a class="btn btn--ghost" href={localePath('hi', '/')}>हिन्दी में</a>
        <a class="btn btn--ghost" href={localePath('en', '/services')}>Services</a>
      </div>
    </div>
  </div>
</Base>
