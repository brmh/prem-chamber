---
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';

/**
 * Bar Council of India, Rule 36: an advocate may not solicit work.
 * The gate is rendered and then shown by script, so crawlers and
 * no-JS visitors still get the page content underneath.
 */
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
---

<div class="gate" id="bci-gate" hidden>
  <div class="gate__panel" role="dialog" aria-modal="true" aria-labelledby="gate-title">
    <h2 id="gate-title">{ui.disclaimer.title}</h2>
    <p>{ui.disclaimer.body}</p>
    <button type="button" class="btn btn--primary" id="bci-accept">{ui.disclaimer.accept}</button>
  </div>
</div>

<script>
  const KEY = 'pc-bci-ack';
  const gate = document.getElementById('bci-gate');
  const accept = document.getElementById('bci-accept');
  let acked = false;
  try { acked = localStorage.getItem(KEY) === '1'; } catch { acked = false; }

  if (gate && !acked) {
    gate.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    accept?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch { /* private window */ }
      gate.hidden = true;
      document.documentElement.style.overflow = '';
    });
  }
</script>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: var(--s-5);
    background: rgba(10, 47, 36, 0.55);
    backdrop-filter: blur(3px);
  }
  .gate[hidden] { display: none; }
  .gate__panel {
    background: var(--paper);
    border-top: 4px solid var(--brass-500);
    border-radius: var(--radius);
    padding: var(--s-6);
    max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 18px 50px rgba(10, 47, 36, 0.3);
  }
  .gate__panel h2 { margin-top: 0; font-size: 1.3rem; }
  .gate__panel p { color: var(--ink-2); font-size: 0.94rem; }
</style>
