---
/** The chamber's mark. The artwork itself lives in <EmblemSprite />, rendered once per page. */
interface Props { size?: number; class?: string; tone?: 'light' | 'dark' }
const { size = 40, class: cls = '', tone = 'dark' } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={cls}
  style={`color:${tone === 'light' ? '#f2ede1' : '#0f4233'}`}
  aria-hidden="true"
  focusable="false"
><use href="#pc-emblem" /></svg>
