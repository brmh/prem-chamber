---
/**
 * The chamber's mark, taken from the printed card: a bow and arrow inside a
 * laurel wreath. Drawn in a 200-unit box so the leaves stay clean at 32px in
 * the header and at 180px on the touch icon.
 *
 * The geometry is generated — see tools/emblem.py — rather than hand-tuned, so
 * the wreath stays evenly spaced if the leaf count or radius is ever changed.
 */
interface Props { size?: number; class?: string; tone?: 'light' | 'dark' }
const { size = 40, class: cls = '', tone = 'dark' } = Astro.props;
const colour = tone === 'light' ? '#f2ede1' : '#0f4233';
---

