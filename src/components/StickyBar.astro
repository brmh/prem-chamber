---
import type { Lang } from '../data/site';
import { SITE, localePath } from '../data/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const waText = lang === 'hi'
  ? 'नमस्ते, मुझे अपने मामले में सलाह चाहिए।'
  : 'Hello, I would like to ask about a matter.';
const waHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(waText)}`;
---

<div class="sticky-bar">
  <a href={`tel:${SITE.phone}`} class="sb sb--call">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z" />
    </svg>
    {ui.cta.callShort}
  </a>
  <a href={waHref} class="sb sb--wa" rel="noopener" target="_blank">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3A2.9 2.9 0 0 0 7 8.4a5 5 0 0 0 1 2.6 11.4 11.4 0 0 0 4.4 3.9c1.6.6 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z" />
    </svg>
    {ui.cta.whatsapp}
  </a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    display: none;
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .sb {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 8px;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
  }
  .sb--call { background: var(--green-800); color: #fff; }
  .sb--wa { background: #1f9e56; color: #fff; }
  .sb--call:hover, .sb--wa:hover { color: #fff; }

  @media (max-width: 860px) { .sticky-bar { display: flex; } }
  @media print { .sticky-bar { display: none; } }
</style>
