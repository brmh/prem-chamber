---
import type { Lang } from '../data/site';
import { SITE, localePath, asset } from '../data/site';
import { t } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Disclaimer from '../components/Disclaimer.astro';
import EmblemSprite from '../components/EmblemSprite.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  /** Locale-free path, e.g. "/services/sale-deed-registry". Drives canonical and hreflang. */
  path: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Extra structured data blocks for this page. */
  jsonLd?: Record<string, unknown>[];
  /**
   * Path the language switcher should point at, when it differs from `path`.
   * Used by pages that have no counterpart in the other language, such as 404.
   */
  langPath?: string;
  noindex?: boolean;
}

const { lang, path, title, description, ogType = 'website', jsonLd = [], noindex = false, langPath } = Astro.props;
const ui = t(lang);
const ch = SITE.chamber;

/** Astro.site, so a preview deployment describes itself rather than production. */
const origin = Astro.site!.href.replace(/\/$/, '');
const canonical = new URL(localePath(lang, path), origin).href;
/** Shared on WhatsApp more than anywhere else, so the card carries the mark. */
const ogImage = new URL(asset(lang === 'hi' ? '/og-hi.png' : '/og-en.png'), origin).href;
const enHref = new URL(localePath('en', path), origin).href;
const hiHref = new URL(localePath('hi', path), origin).href;

/** One LegalService record, repeated site-wide so every page can stand alone in search. */
const business = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': `${origin}/#chamber`,
  name: lang === 'hi' ? SITE.brandHi : SITE.brand,
  url: origin,
  telephone: SITE.phone,
  email: SITE.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: lang === 'hi' ? ch.line1Hi : ch.line1,
    addressLocality: lang === 'hi' ? ch.cityHi : ch.city,
    addressRegion: lang === 'hi' ? ch.stateHi : ch.state,
    postalCode: ch.pincode,
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: ch.lat, longitude: ch.lng },
  areaServed: [
    { '@type': 'City', name: 'Ghaziabad' },
    { '@type': 'AdministrativeArea', name: 'Ghaziabad district' },
  ],
  knowsLanguage: ['hi', 'en'],
  ...(SITE.barCouncil.practisingSince ? { foundingDate: SITE.barCouncil.practisingSince } : {}),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '15:00' },
  ],
  employee: {
    '@type': 'Person',
    name: lang === 'hi' ? SITE.advocate.nameHi : SITE.advocate.name,
    jobTitle: lang === 'hi' ? SITE.advocate.roleHi : SITE.advocate.role,
  },
};

const fontHref =
  lang === 'hi'
    ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Tiro+Devanagari+Hindi&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap';
---

<!doctype html>
<html lang={SITE.locale[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {!noindex && (
      <>
        <link rel="alternate" hreflang="en-IN" href={enHref} />
        <link rel="alternate" hreflang="hi-IN" href={hiHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={lang === 'hi' ? SITE.brandHi : SITE.brand} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'hi' ? SITE.brandHi : SITE.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a2f24" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />
    <link rel="sitemap" href={asset("/sitemap-index.xml")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>

  <body>
    <EmblemSprite />
    <a class="skip" href="#main">{ui.labels.skip}</a>
    <Header lang={lang} path={langPath ?? path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyBar lang={lang} />
    <Disclaimer lang={lang} />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--green-900);
    color: #fff;
    padding: 12px 20px;
    text-decoration: none;
  }
  .skip:focus { left: 8px; top: 8px; }
</style>
